# Server Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
LOG_LEVEL=info

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=logistics_orders
DB_USER=root
DB_PASSWORD=Het@2005
DB_CONNECTION_LIMIT=10

# Test Database Configuration (Used by integration tests)
DB_NAME_TEST=logistics_orders_test

# Security and CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Idempotency
IDEMPOTENCY_KEY_TTL_HOURS=24

# RabbitMQ / Message Broker (Optional for local standalone CRUD)
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_ORDER_EXCHANGE=logistics.orders.exchange
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
