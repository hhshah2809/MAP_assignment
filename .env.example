# =================================================================
# Logistics Control Tower — Environment Configuration Template
# Copy this file to .env before starting services for local dev
# =================================================================

# Global Environment Mode
NODE_ENV=development

# -----------------------------------------------------------------
# MS1: Order Service (Port 3001)
# -----------------------------------------------------------------
ORDER_SERVICE_PORT=3001
ORDER_DB_HOST=localhost
ORDER_DB_PORT=3306
ORDER_DB_NAME=logistics_orders
ORDER_DB_USER=order_app
ORDER_DB_PASSWORD=order_app_password

# -----------------------------------------------------------------
# MS2: Shipment Service (Port 3002)
# -----------------------------------------------------------------
SHIPMENT_SERVICE_PORT=3002
SHIPMENT_DB_HOST=localhost
SHIPMENT_DB_PORT=5432
SHIPMENT_DB_NAME=logistics_shipments
SHIPMENT_DB_USER=postgres
SHIPMENT_DB_PASSWORD=postgres_secure_password
# Optional Supabase Connection (Leave blank if running local PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/logistics_shipments

# -----------------------------------------------------------------
# MS3: Tracking Service (Port 3003)
# -----------------------------------------------------------------
TRACKING_SERVICE_PORT=3003
TRACKING_MONGO_URI=mongodb://localhost:27017
TRACKING_MONGO_DB=logistics_tracking

# -----------------------------------------------------------------
# MS4: Prediction Service (Port 3004)
# -----------------------------------------------------------------
PREDICTION_SERVICE_PORT=3004
PREDICTION_SHIPMENT_HOST=localhost
PREDICTION_TRACKING_HOST=localhost

# -----------------------------------------------------------------
# RabbitMQ Message Broker
# -----------------------------------------------------------------
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=logistics.events

# -----------------------------------------------------------------
# Frontend Dashboard (Port 3000 / 5173)
# -----------------------------------------------------------------
FRONTEND_PORT=3000
VITE_ORDER_SERVICE_URL=http://localhost:3001
VITE_SHIPMENT_SERVICE_URL=http://localhost:3002
VITE_TRACKING_SERVICE_URL=http://localhost:3003
VITE_PREDICTION_SERVICE_URL=http://localhost:3004
